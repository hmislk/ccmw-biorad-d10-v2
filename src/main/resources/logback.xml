<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <property name="LOG_DIR" value="${LOG_DIR:-logs}" />
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- Console: quick visibility when running interactively -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- General application / analyzer-polling log. One file per day, kept for 90 days. -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- LIMS communication log: every request/response exchanged with the hospital LIMS. -->
    <appender name="LIMS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/lims.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/lims.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Errors only, gathered from every logger, for fast triage. -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>180</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
      Audit trail of results actually sent to the LIS. A brand new file is started
      every day (no maxHistory cap: these are kept indefinitely as a clinical audit record).
      Written to only by the "resultsSent" logger below; kept out of app.log to stay clean/parseable.
    -->
    <appender name="RESULTS_SENT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/results-sent/results-sent-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>0</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}\t%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Dedicated logger for the daily results-sent audit log. Not additive: keeps it out of app.log. -->
    <logger name="resultsSent" level="INFO" additivity="false">
        <appender-ref ref="RESULTS_SENT_FILE" />
    </logger>

    <!-- LIMS communication: goes to lims.log, and still bubbles up to app.log/console/error.log via root. -->
    <logger name="com.carecode.biorad.d10.lims" level="INFO" additivity="true">
        <appender-ref ref="LIMS_FILE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="APP_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
